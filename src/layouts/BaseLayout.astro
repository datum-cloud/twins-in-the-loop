---
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Seo from '../components/seo/Seo.astro';
import type { SeoInput, SiteSeoDefaults } from '../lib/seo';
import { withBase } from '../lib/siteEnv';
import type { SocialNetworkId } from '../lib/types';

interface Social {
  name: SocialNetworkId;
  href: string;
}

interface Props extends SeoInput {
  path: string;
  site: SiteSeoDefaults;
  current: 'blog' | 'about' | 'article';
  footer: {
    lead: string;
    blurb: string;
    subscribeBlurb: string;
    subscribeUrl: string;
    datumUrl: string;
    copyrightName: string;
    socials: Social[];
  };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { path, site, current, footer, jsonLd, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={withBase('/favicon-16x16.png')}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase('/favicon-32x32.png')}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href={withBase('/favicon-96x96.png')}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href={withBase('/android-icon-192x192.png')}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase('/apple-touch-icon.png')}
    />
    <link rel="manifest" href={withBase('/manifest.json')} />
    <meta
      name="msapplication-config"
      content={withBase('/browserconfig.xml')}
    />
    <meta name="msapplication-TileColor" content="#384555" />
    <meta name="theme-color" content="#384555" />
    <Seo {...seo} path={path} site={site} jsonLd={jsonLd} />
  </head>
  <body class="text-fjord min-h-screen bg-white font-sans">
    <Header current={current} datumUrl={footer.datumUrl} />
    <main>
      <slot />
    </main>
    <Footer {...footer} />
  </body>
</html>
