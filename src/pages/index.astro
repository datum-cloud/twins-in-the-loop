---
import ArticleCard from '../components/article/ArticleCard.astro';
import AuthorFilter from '../components/article/AuthorFilter.astro';
import TopicFilter from '../components/article/TopicFilter.astro';
import Container from '../components/ui/Container.astro';
import SiteHero from '../components/layout/SiteHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';
import { getPublishedPosts } from '../lib/strapi/posts';
import { getTopics } from '../lib/strapi/topics';
import { setCdnCacheHeaders } from '../lib/httpCache';
import { blogJsonLd } from '../lib/jsonLd';
import { withBase } from '../lib/siteEnv';

setCdnCacheHeaders(Astro.response.headers);

const site = await getSiteSettings();
const [posts, topics] = await Promise.all([getPublishedPosts(), getTopics()]);

const siteSeo = {
  title: site.title,
  description: site.description,
  siteUrl: Astro.site?.toString() ?? 'https://twinsintheloop.com',
  defaultOgImage: site.defaultOgImage,
};
---

<BaseLayout
  path="/"
  current="blog"
  site={siteSeo}
  title={site.title}
  description={site.description}
  canonical={site.canonical}
  og={site.og}
  noindex={site.noindex}
  keywords={site.keywords}
  footer={{
    lead: site.title,
    blurb: site.footerBlurb,
    subscribeBlurb: site.subscribeBlurb,
    subscribeUrl: site.subscribeUrl,
    datumUrl: site.datumUrl,
    copyrightName: site.copyright,
    socials: site.socials,
  }}
  jsonLd={blogJsonLd({
    name: site.title,
    description: site.description,
    url: siteSeo.siteUrl,
    publisher: { name: site.copyright, url: site.datumUrl },
  })}
>
  <SiteHero />
  <Container columns="12" class="pt-10 pb-20 lg:pb-40" data-filter-root>
    <div class="col-span-full flex flex-col gap-10 lg:gap-16">
      <div class="border-divider flex flex-col gap-7.5 border-b pb-7.5">
        <div
          class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"
        >
          <div class="hidden">
            <TopicFilter topics={topics} />
          </div>
          <div class="ml-auto">
            <AuthorFilter current="all" />
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-10 md:gap-14 lg:gap-20">
        <div class="grid gap-10 md:grid-cols-2 md:gap-8 lg:gap-12 2xl:gap-20">
          {
            posts.map((post) => (
              <ArticleCard
                href={withBase(`/${post.id}`)}
                title={post.data.title}
                excerpt={post.data.excerpt}
                published={post.data.published}
                author={post.data.author}
                type={post.data.type}
                cover={post.data.cover}
                topics={post.data.topics}
              />
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  const authorFilter = document.querySelector<HTMLElement>(
    '[data-filter-select="author"]',
  );
  const chips = document.querySelectorAll<HTMLElement>('[data-topic]');

  function setChipActive(chip: HTMLElement, active: boolean) {
    chip.classList.toggle('bg-fjord', active);
    chip.classList.toggle('text-white', active);
    chip.classList.toggle('border', !active);
    chip.classList.toggle('border-fjord', !active);
    chip.classList.toggle('bg-transparent', !active);
    chip.classList.toggle('text-fjord', !active);
  }

  function syncFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const topic = params.get('topic');
    const author = params.get('author') ?? 'all';
    authorFilter?.dispatchEvent(
      new CustomEvent('select:sync', { detail: author }),
    );
    chips.forEach((chip) => {
      const active = chip.dataset.topic === topic;
      setChipActive(chip, active);
      chip.setAttribute('aria-pressed', String(active));
    });
    document.querySelectorAll<HTMLElement>('[data-author]').forEach((node) => {
      const matchAuthor = author === 'all' || node.dataset.author === author;
      const topics = (node.dataset.topics ?? '').split(' ').filter(Boolean);
      const matchTopic = !topic || topics.includes(topic);
      node.classList.toggle('hidden', !(matchAuthor && matchTopic));
    });
  }

  function replaceFilter(key: string, value: string | null) {
    const url = new URL(window.location.href);
    if (!value) {
      url.searchParams.delete(key);
    } else {
      url.searchParams.set(key, value);
    }
    window.history.replaceState({}, '', url);
    syncFromUrl();
  }

  authorFilter?.addEventListener('select:change', (event) => {
    const value = (event as CustomEvent<string>).detail;
    replaceFilter('author', value === 'all' ? null : value);
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', (event) => {
      event.preventDefault();
      const value = chip.dataset.topic;
      const current = new URLSearchParams(window.location.search).get('topic');
      replaceFilter('topic', !value || value === current ? null : value);
    });
  });

  syncFromUrl();
</script>
