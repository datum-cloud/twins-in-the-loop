---
import { withBase } from '../../lib/siteEnv';
import type { Topic } from '../../lib/strapi/topics';
import type { TopicId } from '../../lib/types';
import Chip from '../ui/Chip.astro';

interface Props {
  topics: Topic[];
  current?: TopicId;
}

const { topics, current } = Astro.props;
---

<div class="flex flex-wrap items-center gap-4">
  <p class="text-fjord text-base font-semibold">Explore topics:</p>
  <div class="flex flex-wrap gap-2">
    <Chip href={withBase('/')} active={!current} data-topic="all">All</Chip>
    {
      topics.map((topic) => (
        <Chip
          href={withBase(`/?topic=${topic.slug}`)}
          active={current === topic.slug}
          data-topic={topic.slug}
        >
          {topic.name}
        </Chip>
      ))
    }
  </div>
</div>
