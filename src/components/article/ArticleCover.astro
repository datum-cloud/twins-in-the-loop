---
import { Image } from 'astro:assets';
import {
  ARTICLE_COVER_SIZES,
  OPTIMIZED_IMAGE_FORMAT,
  OPTIMIZED_IMAGE_QUALITY,
  articleCoverWidths,
} from '../../lib/images';
import type { PostCover } from '../../lib/strapi/posts';

interface Props {
  cover: PostCover;
}

const { cover } = Astro.props;
---

<Image
  src={cover.src}
  alt={cover.alt}
  width={cover.width}
  height={cover.height}
  widths={articleCoverWidths(cover.width)}
  sizes={ARTICLE_COVER_SIZES}
  format={OPTIMIZED_IMAGE_FORMAT}
  quality={OPTIMIZED_IMAGE_QUALITY}
  class="mb-10 w-full object-cover"
/>
