---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  url: string;
  title: string;
  compact?: boolean;
}

const { url, title, compact = false } = Astro.props;
---

<div class:list={[compact ? '' : 'flex w-full flex-col gap-2']} data-share-root data-share-url={url} data-share-title={title}>
  {
    compact ? (
      <Button href={url} variant="icon" icon="share" class="text-white" data-share-button aria-label="Share article" />
    ) : (
      <>
        <button
          type="button"
          class="inline-flex h-13 w-full cursor-pointer items-center justify-center gap-2 rounded-md border border-fjord px-7 text-xs font-semibold text-fjord hover:bg-fjord hover:text-white active:translate-y-px motion-reduce:active:translate-y-0"
          data-copy-link
        >
          <span data-copy-label>Copy article link</span>
          <Icon name="link" size={16} />
        </button>
        <button
          type="button"
          class="inline-flex h-13 w-full cursor-pointer items-center justify-center gap-2 rounded-md border border-fjord px-7 text-xs font-semibold text-fjord hover:bg-fjord hover:text-white active:translate-y-px motion-reduce:active:translate-y-0"
          data-share-button
        >
          Share article
          <Icon name="share" size={16} />
        </button>
      </>
    )
  }
</div>

<script>
  function bindShare(root: HTMLElement) {
    const url = root.dataset.shareUrl ?? location.href;
    const title = root.dataset.shareTitle ?? document.title;
    root.querySelectorAll('[data-copy-link]').forEach((button) => {
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(url);
        const label = button.querySelector('[data-copy-label]');
        if (label) {
          label.textContent = 'Copied';
        }
      });
    });
    root.querySelectorAll('[data-share-button]').forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        if (navigator.share) {
          await navigator.share({ title, url });
          return;
        }
        await navigator.clipboard.writeText(url);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-share-root]').forEach(bindShare);
</script>
