---
import { Image } from 'astro:assets';
import type { PostCover } from '../../lib/strapi/posts';
import type { AuthorId, ContentType, TopicId } from '../../lib/types';
import { formatPostDate } from '../../lib/dates';
import {
  CARD_THUMBNAIL_SIZES,
  OPTIMIZED_IMAGE_FORMAT,
  OPTIMIZED_IMAGE_QUALITY,
  thumbnailWidths,
} from '../../lib/images';
import AuthorTag from '../ui/AuthorTag.astro';

interface Props {
  href: string;
  title: string;
  description?: string;
  published: Date;
  author: AuthorId;
  type: ContentType;
  cover?: PostCover;
  topics: TopicId[];
}

const { href, title, description, published, author, type, cover, topics } =
  Astro.props;
---

<article
  class="bg-mist flex h-full flex-col"
  data-author={author}
  data-topics={topics.join(' ')}
>
  <a href={href} class="group flex h-full flex-col gap-6 no-underline md:gap-9">
    <div class="bg-slate-night relative h-60 overflow-hidden sm:h-72 xl:h-90">
      {
        cover ? (
          <Image
            src={cover.src}
            alt={cover.alt}
            width={cover.width}
            height={cover.height}
            widths={thumbnailWidths(cover.width)}
            sizes={CARD_THUMBNAIL_SIZES}
            format={OPTIMIZED_IMAGE_FORMAT}
            quality={OPTIMIZED_IMAGE_QUALITY}
            class="absolute inset-0 size-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        ) : null
      }
      <div class="absolute bottom-0 left-0">
        <AuthorTag author={author} type={type} />
      </div>
    </div>
    <div
      class="text-fjord flex flex-1 flex-col gap-3 px-5 pb-6 md:px-8 md:pb-8 xl:px-10 xl:pb-10"
    >
      <h2
        class="text-2xl leading-7.5 font-semibold group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4"
      >
        {title}
      </h2>
      {description ? <p class="text-lg leading-6.5">{description}</p> : null}
      <p class="text-fjord/60 text-base leading-6">
        {formatPostDate(published)}
      </p>
    </div>
  </a>
</article>
