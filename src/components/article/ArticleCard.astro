---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { AuthorId, ContentType, TopicId } from '../../lib/types';
import { formatPostDate } from '../../lib/dates';
import {
  CARD_THUMBNAIL_SIZES,
  OPTIMIZED_IMAGE_FORMAT,
  OPTIMIZED_IMAGE_QUALITY,
  thumbnailWidths,
} from '../../lib/images';
import AuthorTag from '../ui/AuthorTag.astro';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  published: Date;
  author: AuthorId;
  type: ContentType;
  cover?: ImageMetadata;
  topics: TopicId[];
}

const { href, title, excerpt, published, author, type, cover, topics } =
  Astro.props;

let shadow: 'shadow-zac' | 'shadow-jacob';
switch (author) {
  case 'zac':
    shadow = 'shadow-zac';
    break;
  case 'jacob':
    shadow = 'shadow-jacob';
    break;
  default: {
    const _exhaustive: never = author;
    shadow = _exhaustive;
  }
}
---

<article
  class:list={['border-fjord flex h-full flex-col border-2 bg-white', shadow]}
  data-author={author}
  data-topics={topics.join(' ')}
>
  <a
    href={href}
    class="flex h-full flex-col no-underline hover:opacity-90 active:opacity-80"
  >
    <div class="bg-fjord relative h-90 overflow-hidden">
      {
        cover ? (
          <Image
            src={cover}
            alt=""
            widths={thumbnailWidths(cover.width)}
            sizes={CARD_THUMBNAIL_SIZES}
            format={OPTIMIZED_IMAGE_FORMAT}
            quality={OPTIMIZED_IMAGE_QUALITY}
            class="absolute inset-0 size-full object-cover"
          />
        ) : null
      }
      <div class="absolute top-0 left-0">
        <AuthorTag author={author} type={type} />
      </div>
    </div>
    <div
      class="text-fjord flex flex-1 flex-col gap-3 px-5 pt-6 pb-6 md:px-8 md:pt-8 md:pb-8 xl:px-10 xl:pt-9 xl:pb-10"
    >
      <h2 class="text-2xl leading-7.5 font-semibold">{title}</h2>
      <p class="text-lg leading-6.5">{excerpt}</p>
      <p class="text-fjord/60 text-base leading-6">
        {formatPostDate(published)}
      </p>
    </div>
  </a>
</article>
