---
import type { ImageMetadata } from 'astro';
import type { AuthorId, ContentType } from '../../lib/types';
import ArticleRow from './ArticleRow.astro';

interface RelatedPost {
  href: string;
  title: string;
  published: Date;
  author: AuthorId;
  authorName: string;
  authorPhoto: ImageMetadata;
  type: ContentType;
}

interface Props {
  posts: RelatedPost[];
  heading?: string;
}

const { posts, heading = 'More articles:' } = Astro.props;
---

<section class="mt-16">
  <h2 class="text-fjord text-2xl font-semibold">{heading}</h2>
  <div class="border-slate-night mt-6 flex flex-col gap-2 border-t-2">
    {posts.map((post) => <ArticleRow {...post} />)}
  </div>
</section>
