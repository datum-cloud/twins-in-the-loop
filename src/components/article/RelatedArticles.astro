---
import type { AuthorId } from '../../lib/types';
import ArticleRow from './ArticleRow.astro';

interface RelatedPost {
  href: string;
  title: string;
  published: Date;
  author: AuthorId;
}

interface Props {
  posts: RelatedPost[];
}

const { posts } = Astro.props;
---

<section class="mt-16">
  <h2 class="text-2xl font-semibold text-fjord">More articles:</h2>
  <div class="mt-6 border-t-2 border-jacob">
    {posts.map((post) => <ArticleRow {...post} />)}
  </div>
</section>
