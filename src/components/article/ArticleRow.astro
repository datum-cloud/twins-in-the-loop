---
import type { AuthorId, TopicId } from '../../lib/types';
import { formatListDate } from '../../lib/dates';

interface Props {
  href: string;
  title: string;
  published: Date;
  author: AuthorId;
  topics?: TopicId[];
  neutral?: boolean;
}

const {
  href,
  title,
  published,
  author,
  topics = [],
  neutral = false,
} = Astro.props;
const border = neutral
  ? 'border-fjord'
  : author === 'zac'
    ? 'border-zac'
    : 'border-jacob';
---

<a
  href={href}
  class:list={[
    'text-fjord hover:bg-mist/70 active:bg-mist flex items-center justify-between gap-6 border-b-2 py-8 no-underline',
    border,
  ]}
  data-author={author}
  data-topics={topics.join(' ')}
>
  <span class="text-xl leading-7 font-semibold">{title}</span>
  <time
    class="text-fjord/40 shrink-0 text-sm"
    datetime={published.toISOString()}
  >
    {formatListDate(published)}
  </time>
</a>
