---
import {
  CONTENT_TYPE_LABELS,
  type AuthorId,
  type ContentType,
  type TopicId,
} from '../../lib/types';
import { formatListDate } from '../../lib/dates';
import ContentTypeIcon from '../ui/ContentTypeIcon.astro';

interface Props {
  href: string;
  title: string;
  published: Date;
  author: AuthorId;
  type: ContentType;
  topics?: TopicId[];
  neutral?: boolean;
}

const {
  href,
  title,
  published,
  author,
  type,
  topics = [],
  neutral = false,
} = Astro.props;
const border = neutral
  ? 'border-fjord'
  : author === 'zac'
    ? 'border-zac'
    : 'border-jacob';
---

<a
  href={href}
  class:list={[
    'text-fjord hover:bg-mist/70 active:bg-mist flex items-center justify-between gap-6 border-b-2 py-8 no-underline',
    border,
  ]}
  data-author={author}
  data-topics={topics.join(' ')}
>
  <span class="flex min-w-0 items-start gap-3">
    <ContentTypeIcon
      type={type}
      size={20}
      class="mt-0.5 shrink-0"
      alt={CONTENT_TYPE_LABELS[type]}
    />
    <span class="text-xl leading-7 font-semibold">{title}</span>
  </span>
  <time
    class="text-fjord/40 shrink-0 text-sm"
    datetime={published.toISOString()}
  >
    {formatListDate(published)}
  </time>
</a>
