---
import type { AuthorId, TopicId } from '../../lib/types';
import { formatListDate } from '../../lib/dates';

interface Props {
  href: string;
  title: string;
  published: Date;
  author: AuthorId;
  topics?: TopicId[];
}

const { href, title, published, author, topics = [] } = Astro.props;
const border = author === 'zac' ? 'border-zac' : 'border-jacob';
---

<a
  href={href}
  class:list={['flex items-center justify-between gap-6 border-b-2 py-8 text-fjord no-underline hover:bg-mist/70 active:bg-mist', border]}
  data-author={author}
  data-topics={topics.join(' ')}
>
  <span class="text-xl font-semibold leading-7">{title}</span>
  <time class="shrink-0 text-sm text-fjord/40" datetime={published.toISOString()}>
    {formatListDate(published)}
  </time>
</a>
