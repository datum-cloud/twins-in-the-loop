---
import type { ImageMetadata } from 'astro';
import { formatPostDate } from '../../lib/dates';
import PageHero from '../layout/PageHero.astro';
import ShareActions from './ShareActions.astro';

interface Props {
  title: string;
  published: Date;
  authorName: string;
  authorRole: string;
  authorPhoto: ImageMetadata;
  url: string;
}

const { title, published, authorName, authorRole, authorPhoto, url } = Astro.props;
---

<PageHero>
  <p class="text-sm text-white/70">{formatPostDate(published)}</p>
  <h1 class="mt-4 text-5xl font-semibold leading-14.5 tracking-heading text-white">
    {title}
  </h1>
  <div class="mt-10 flex items-center gap-6">
    <img src={authorPhoto.src} alt="" width="60" height="60" class="size-15 rounded-full object-cover" />
    <div class="min-w-0 flex-1">
      <p class="text-base font-semibold text-white">{authorName}</p>
      <p class="text-sm text-white/70">{authorRole}</p>
    </div>
    <ShareActions url={url} title={title} compact />
  </div>
</PageHero>
