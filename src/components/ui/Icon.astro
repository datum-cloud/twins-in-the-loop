---
import type { IconName } from '../../lib/types';

interface Props {
  name: IconName;
  size?: number;
  alt?: string;
  class?: string;
}

const { name, size = 16, alt = '', class: className } = Astro.props;
---

<span
  class:list={['inline-block shrink-0 bg-current', className]}
  style={`width:${size}px;height:${size}px;-webkit-mask:url('/icons/${name}.svg') center / contain no-repeat;mask:url('/icons/${name}.svg') center / contain no-repeat;mask-mode:alpha;`}
  role={alt ? 'img' : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : 'true'}
></span>
