---
interface Props {
  variant?: 'intro' | 'body';
  class?: string;
}

const { variant = 'body', class: className } = Astro.props;
const classes =
  variant === 'intro'
    ? 'text-xl leading-8.5 [&_a]:underline [&_a]:hover:opacity-70 [&_a]:active:opacity-50 [&_p+p]:mt-5'
    : 'text-lg leading-7 [&_a]:underline [&_a]:hover:opacity-70 [&_a]:active:opacity-50 [&_h2]:mt-10 [&_h2]:mb-5 [&_h2]:text-2xl [&_h2]:font-semibold [&_p+p]:mt-5 [&_img]:my-10 [&_pre]:my-8';
---

<div class:list={['max-w-none text-fjord', classes, className]}>
  <slot />
</div>
