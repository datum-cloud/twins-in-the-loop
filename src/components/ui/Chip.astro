---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href?: string;
  active?: boolean;
  inverse?: boolean;
}

const { href, active = false, inverse = false, class: className, ...rest } = Astro.props;

const classes = inverse
  ? active
    ? 'bg-white text-fjord hover:opacity-80 active:opacity-70'
    : 'bg-transparent text-white hover:bg-white/15 active:bg-white/25'
  : active
    ? 'bg-fjord text-white hover:opacity-90 active:opacity-80'
    : 'border border-fjord bg-transparent text-fjord hover:bg-fjord hover:text-white active:translate-y-px motion-reduce:active:translate-y-0';
---

{
  href ? (
    <a
      href={href}
      class:list={[
        'inline-flex h-7 items-center justify-center rounded-2xs px-2 text-base',
        classes,
        className,
      ]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <span
      class:list={[
        'inline-flex h-7 items-center justify-center rounded-2xs px-2 text-base',
        classes,
        className,
      ]}
      {...rest}
    >
      <slot />
    </span>
  )
}
