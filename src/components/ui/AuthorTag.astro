---
import { AUTHOR_LABELS, type AuthorId, type ContentType } from '../../lib/types';
import ContentTypeIcon from './ContentTypeIcon.astro';

interface Props {
  author: AuthorId;
  type: ContentType;
}

const { author, type } = Astro.props;
const tone = author === 'zac' ? 'bg-zac-tag' : 'bg-jacob-tag';
---

<div class:list={['inline-flex items-center gap-2.5 px-5.5 py-3.5 font-mono text-sm text-fjord', tone]}>
  <span>{AUTHOR_LABELS[author]}</span>
  <ContentTypeIcon type={type} size={20} />
</div>
