---
import Icon from './Icon.astro';

type Accent = 'all' | 'zac' | 'jacob';

interface Option {
  value: string;
  label: string;
  accent?: Accent;
}

interface Props {
  name: string;
  value: string;
  options: Option[];
  label: string;
  class?: string;
}

const { name, value, options, label, class: className } = Astro.props;
const current = options.find((option) => option.value === value) ?? options[0];
const listId = `${name}-listbox`;

function accentKind(accent: Accent | undefined) {
  switch (accent) {
    case 'all':
      return 'both';
    case 'zac':
      return 'zac';
    case 'jacob':
      return 'jacob';
    case undefined:
      return 'none';
    default: {
      const exhaustive: never = accent;
      return exhaustive;
    }
  }
}
---

<div
  class:list={['relative z-20 inline-flex shrink-0 items-center gap-4', className]}
  data-select
  data-filter-select={name}
  data-value={current?.value}
>
  <span class="text-base font-semibold text-fjord" id={`${name}-label`}>{label}</span>
  <div class="relative">
    <button
      type="button"
      class="inline-flex h-7 shrink-0 cursor-pointer items-center gap-1 whitespace-nowrap rounded-2xs border border-fjord bg-white px-2 text-base text-fjord hover:bg-mist active:bg-fjord active:text-white"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={`Show articles by: ${current?.label}`}
      aria-controls={listId}
      data-select-trigger
    >
      <span
        class="inline-flex shrink-0 items-center"
        data-select-dots="all"
        hidden={accentKind(current?.accent) !== 'both'}
        aria-hidden="true"
      >
        <span class="size-2.5 rounded-full bg-zac"></span>
        <span class="-ml-1 size-2.5 rounded-full bg-jacob"></span>
      </span>
      <span
        class="inline-flex shrink-0 items-center"
        data-select-dots="zac"
        hidden={accentKind(current?.accent) !== 'zac'}
        aria-hidden="true"
      >
        <span class="size-2.5 rounded-full bg-zac"></span>
      </span>
      <span
        class="inline-flex shrink-0 items-center"
        data-select-dots="jacob"
        hidden={accentKind(current?.accent) !== 'jacob'}
        aria-hidden="true"
      >
        <span class="size-2.5 rounded-full bg-jacob"></span>
      </span>
      <span class="whitespace-nowrap" data-select-current>{current?.label}</span>
      <span data-select-chevron class="inline-flex shrink-0 transition-transform">
        <Icon name="chevron-down" size={16} />
      </span>
    </button>
    <ul
      id={listId}
      role="listbox"
      aria-labelledby={`${name}-label`}
      class="absolute right-0 top-full mt-1.5 hidden min-w-47 border-2 border-fjord bg-white py-1 shadow-hard"
      data-select-menu
    >
      {
        options.map((option) => {
          const selected = option.value === current?.value;
          const kind = accentKind(option.accent);

          return (
            <li role="none">
              <button
                type="button"
                role="option"
                aria-selected={selected}
                class:list={[
                  'flex w-full cursor-pointer items-center gap-2.5 px-3 py-2 text-left text-base',
                  selected ? 'bg-fjord text-white' : 'text-fjord hover:bg-mist active:bg-mist',
                ]}
                data-select-option
                data-value={option.value}
                data-label={option.label}
              >
                {
                  kind === 'both' ? (
                    <span class="inline-flex items-center" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-zac" />
                      <span class="-ml-1 size-2.5 rounded-full bg-jacob" />
                    </span>
                  ) : kind === 'zac' ? (
                    <span class="size-2.5 rounded-full bg-zac" aria-hidden="true" />
                  ) : kind === 'jacob' ? (
                    <span class="size-2.5 rounded-full bg-jacob" aria-hidden="true" />
                  ) : null
                }
                {option.label}
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-select]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-select-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-select-menu]');
    const current = root.querySelector<HTMLElement>('[data-select-current]');
    const chevron = root.querySelector<HTMLElement>('[data-select-chevron]');
    const options = root.querySelectorAll<HTMLButtonElement>('[data-select-option]');

    if (!trigger || !menu) {
      return;
    }

    const triggerButton = trigger;
    const menuList = menu;

    function isOpen() {
      return triggerButton.getAttribute('aria-expanded') === 'true';
    }

    function setOpen(open: boolean) {
      triggerButton.setAttribute('aria-expanded', String(open));
      menuList.classList.toggle('hidden', !open);
      chevron?.classList.toggle('rotate-180', open);
    }

    function apply(value: string, emit: boolean) {
      root.dataset.value = value;
      options.forEach((option) => {
        const selected = option.dataset.value === value;
        option.setAttribute('aria-selected', String(selected));
        option.classList.toggle('bg-fjord', selected);
        option.classList.toggle('text-white', selected);
        option.classList.toggle('hover:bg-mist', !selected);
        option.classList.toggle('text-fjord', !selected);
        if (selected && current) {
          current.textContent = option.dataset.label ?? value;
          triggerButton.setAttribute('aria-label', `Show articles by: ${option.dataset.label ?? value}`);
        }
      });
      root.querySelectorAll<HTMLElement>('[data-select-dots]').forEach((dot) => {
        dot.hidden = dot.dataset.selectDots !== value;
      });
      if (emit) {
        root.dispatchEvent(new CustomEvent('select:change', { detail: value, bubbles: true }));
      }
    }

    triggerButton.addEventListener('click', () => {
      setOpen(!isOpen());
    });

    options.forEach((option) => {
      option.addEventListener('click', () => {
        apply(option.dataset.value ?? '', true);
        setOpen(false);
        triggerButton.focus();
      });
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    });

    root.addEventListener('select:sync', ((event: CustomEvent<string>) => {
      apply(event.detail, false);
    }) as EventListener);
  });
</script>
