---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import logoStackedOnLight from '../../assets/logo/twins-in-the-loop-logo-alt.svg?raw';
import logoStackedPng from '../../assets/logo/twins-in-the-loop-logo-alt.png';
import logoWidePng from '../../assets/logo/twins-in-the-loop-logo.png';
import {
  LOGO_IMAGE_FORMAT,
  LOGO_STACKED_SIZES,
  LOGO_WIDE_SIZES,
  OPTIMIZED_IMAGE_QUALITY,
  logoStackedWidths,
  logoWideWidths,
} from '../../lib/images';
import { withBase } from '../../lib/siteEnv';

interface Props {
  theme?: 'on-dark' | 'on-light';
  mark?: 'wide' | 'stacked';
  size?: 'sm' | 'lg';
  stacked?: boolean;
  href?: string;
}

const {
  theme = 'on-dark',
  mark = 'stacked',
  href = withBase('/'),
} = Astro.props;

function rasterLogo(
  mark: 'wide' | 'stacked',
  theme: 'on-dark' | 'on-light',
): ImageMetadata | undefined {
  switch (mark) {
    case 'wide':
      return logoWidePng;
    case 'stacked':
      switch (theme) {
        case 'on-dark':
          return logoStackedPng;
        case 'on-light':
          return undefined;
        default: {
          const _exhaustive: never = theme;
          return _exhaustive;
        }
      }
    default: {
      const _exhaustive: never = mark;
      return _exhaustive;
    }
  }
}

function rasterClass(mark: 'wide' | 'stacked'): string {
  switch (mark) {
    case 'wide':
      return 'h-auto w-full max-w-217';
    case 'stacked':
      return 'h-35 w-auto';
    default: {
      const _exhaustive: never = mark;
      return _exhaustive;
    }
  }
}

function rasterWidths(mark: 'wide' | 'stacked', sourceWidth: number): number[] {
  switch (mark) {
    case 'wide':
      return logoWideWidths(sourceWidth);
    case 'stacked':
      return logoStackedWidths(sourceWidth);
    default: {
      const _exhaustive: never = mark;
      return _exhaustive;
    }
  }
}

function rasterSizes(mark: 'wide' | 'stacked'): string {
  switch (mark) {
    case 'wide':
      return LOGO_WIDE_SIZES;
    case 'stacked':
      return LOGO_STACKED_SIZES;
    default: {
      const _exhaustive: never = mark;
      return _exhaustive;
    }
  }
}

const raster = rasterLogo(mark, theme);
---

<a
  href={href}
  class="inline-flex items-start no-underline transition-opacity duration-200 ease-in-out hover:opacity-90 active:opacity-80 motion-reduce:transition-none"
  aria-label="Twins in the Loop"
>
  {
    raster ? (
      <Image
        src={raster}
        alt=""
        widths={rasterWidths(mark, raster.width)}
        sizes={rasterSizes(mark)}
        format={LOGO_IMAGE_FORMAT}
        quality={OPTIMIZED_IMAGE_QUALITY}
        class={rasterClass(mark)}
      />
    ) : (
      <span
        class="inline-block h-35 w-auto max-w-full overflow-visible [&_svg]:isolation-auto [&_svg]:block [&_svg]:h-full [&_svg]:w-auto [&_svg]:overflow-visible"
        aria-hidden="true"
        set:html={logoStackedOnLight}
      />
    )
  }
</a>
