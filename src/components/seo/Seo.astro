---
import { resolveSeo, withSiteTitle, type SeoInput, type SiteSeoDefaults } from '../../lib/seo';
import JsonLd from './JsonLd.astro';

interface Props extends SeoInput {
  path: string;
  site: SiteSeoDefaults;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { path, site, jsonLd, ...input } = Astro.props;
const seo = resolveSeo(input, site, path);
const title = withSiteTitle(seo.title, site.title);
---

<title>{title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
{seo.keywords ? <meta name="keywords" content={seo.keywords.join(', ')} /> : null}
<link rel="canonical" href={seo.canonical} />
<meta property="og:title" content={seo.ogTitle} />
<meta property="og:description" content={seo.ogDescription} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.ogTitle} />
<meta name="twitter:description" content={seo.ogDescription} />
<meta name="twitter:image" content={seo.ogImage} />
{jsonLd ? <JsonLd data={jsonLd} /> : null}
