---
import {
  resolveSeo,
  withSiteTitle,
  type SeoInput,
  type SiteSeoDefaults,
} from '../../lib/seo';
import { withBase } from '../../lib/siteEnv';
import JsonLd from './JsonLd.astro';

interface Props extends SeoInput {
  path: string;
  site: SiteSeoDefaults;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { path, site, jsonLd, ...input } = Astro.props;
const seo = resolveSeo(input, site, path);
const title = withSiteTitle(seo.title, site.title);
---

<title>{title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
{
  seo.keywords ? (
    <meta name="keywords" content={seo.keywords.join(', ')} />
  ) : null
}
<link rel="canonical" href={seo.canonical} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.title} RSS`}
  href={new URL(withBase('/rss.xml'), site.siteUrl).toString()}
/>
{seo.article ? <meta name="author" content={seo.article.author} /> : null}
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={seo.ogTitle} />
<meta property="og:description" content={seo.ogDescription} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
{
  seo.ogImage.startsWith('https://') ? (
    <meta property="og:image:secure_url" content={seo.ogImage} />
  ) : null
}
{
  seo.ogImageType ? (
    <meta property="og:image:type" content={seo.ogImageType} />
  ) : null
}
{
  seo.ogImageWidth && seo.ogImageHeight ? (
    <>
      <meta property="og:image:width" content={String(seo.ogImageWidth)} />
      <meta property="og:image:height" content={String(seo.ogImageHeight)} />
    </>
  ) : null
}
<meta property="og:image:alt" content={seo.ogTitle} />
{
  seo.article ? (
    <>
      <meta
        property="article:published_time"
        content={seo.article.publishedTime.toISOString()}
      />
      <meta
        property="article:modified_time"
        content={(
          seo.article.modifiedTime ?? seo.article.publishedTime
        ).toISOString()}
      />
      <meta property="article:author" content={seo.article.author} />
      {seo.article.topics?.map((topic) => (
        <meta property="article:tag" content={topic} />
      ))}
    </>
  ) : null
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.ogTitle} />
<meta name="twitter:description" content={seo.ogDescription} />
<meta name="twitter:image" content={seo.ogImage} />
{jsonLd ? <JsonLd data={jsonLd} /> : null}
