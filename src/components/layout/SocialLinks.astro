---
import { socialLinkLabel, type SocialNetworkId } from '../../lib/types';
import Icon from '../ui/Icon.astro';

interface Social {
  name: SocialNetworkId;
  href: string;
}

interface Props {
  items: Social[];
}

const { items } = Astro.props;
---

<ul class="text-fjord flex items-start gap-2.5">
  {
    items.map((item) => {
      const label = socialLinkLabel(item.name);

      return (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer noopener"
            class="text-fjord inline-flex size-5 overflow-clip hover:opacity-70 active:opacity-40"
          >
            <span class="sr-only">{label}</span>
            <Icon name={item.name} size={20} />
          </a>
        </li>
      );
    })
  }
</ul>
