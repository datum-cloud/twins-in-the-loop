---
import Chip from '../ui/Chip.astro';
import Container from '../ui/Container.astro';
import TextLink from '../ui/TextLink.astro';
import { withBase } from '../../lib/siteEnv';

interface Props {
  current: 'blog' | 'about' | 'article';
  datumUrl: string;
}

const { current, datumUrl } = Astro.props;
---

<header class="bg-fjord border-b border-white">
  <Container
    class="flex flex-row flex-wrap items-center justify-between gap-x-4 gap-y-3 py-4 sm:flex-nowrap sm:gap-6 sm:py-5 lg:grid lg:grid-cols-12 lg:gap-7"
  >
    <nav
      class="flex items-center gap-4 lg:col-span-6 lg:gap-10"
      aria-label="Primary"
    >
      <Chip href={withBase('/')} active={current !== 'about'} inverse>Blog</Chip
      >
      <TextLink
        href={withBase('/about')}
        class={current === 'about' ? 'font-semibold text-white' : 'text-white'}
      >
        About
      </TextLink>
    </nav>
    <div class="flex items-center gap-4 sm:justify-end lg:col-span-6 lg:gap-10">
      <TextLink
        href="#stay-in-the-loop"
        icon="arrow-down"
        class="whitespace-nowrap text-white"
      >
        Stay in the loop
      </TextLink>
      <TextLink
        href={datumUrl}
        icon="external-link"
        external
        class="whitespace-nowrap text-white"
      >
        Datum.net
      </TextLink>
    </div>
  </Container>
</header>
