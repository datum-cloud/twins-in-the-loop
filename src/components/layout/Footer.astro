---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { withBase } from '../../lib/siteEnv';
import type { SocialNetworkId } from '../../lib/types';

interface Social {
  name: SocialNetworkId;
  href: string;
}

interface Props {
  lead: string;
  blurb: string;
  subscribeBlurb: string;
  subscribeUrl: string;
  datumUrl: string;
  copyrightName: string;
  socials: Social[];
}

const {
  lead,
  blurb,
  subscribeBlurb,
  subscribeUrl,
  datumUrl,
  copyrightName,
  socials,
} = Astro.props;
const year = new Date().getFullYear();
const blurbBody = blurb.startsWith(lead)
  ? blurb.slice(lead.length)
  : ` ${blurb}`;
---

<footer id="stay-in-the-loop" class="bg-slate-night text-white">
  <Container columns="12" class="items-center gap-y-12 py-20">
    <div class="col-span-full lg:col-span-4">
      <Logo mark="badge" size="sm" />
    </div>
    <div
      class="md:grid-cols-footer col-span-full grid gap-16 md:items-stretch lg:col-span-8"
    >
      <div class="flex flex-col items-start justify-center gap-8">
        <p class="text-lg leading-6.5 font-normal text-white">
          <span class="font-semibold">{lead}</span>{blurbBody}{' '}
          <a
            href={withBase('/about')}
            class="font-normal underline decoration-solid hover:opacity-70 active:opacity-50"
            >Learn more</a
          >
        </p>
        <div
          class="grid w-full grid-cols-[minmax(0,1fr)_auto] items-center gap-6"
        >
          <p class="text-sm leading-5 font-normal text-white/60">
            {subscribeBlurb}
          </p>
          <Button
            href={subscribeUrl}
            variant="outline-inverse"
            icon="mail"
            aria-label="Stay in the loop"
          >
            Stay in the loop
          </Button>
        </div>
      </div>
      <div class="hidden w-px self-stretch bg-white md:block"></div>
      <div class="flex flex-col justify-between gap-8">
        <div class="flex w-full flex-col items-start gap-2">
          <p class="max-w-39 text-xs leading-4 font-normal text-white">
            Learn more about what the twins are doing with Datum
          </p>
          <Button
            href={datumUrl}
            variant="outline-inverse"
            icon="external-link"
            class="w-full"
            aria-label="Visit Datum.net"
          >
            Datum.net
          </Button>
        </div>
        <div class="flex flex-col items-start gap-1">
          <p class="text-xs leading-4 font-normal text-white">Find Datum on:</p>
          <SocialLinks items={socials} />
        </div>
        <p class="text-xs leading-4 font-normal text-white/40">
          {`© ${year} ${copyrightName}`}
        </p>
      </div>
    </div>
  </Container>
</footer>
