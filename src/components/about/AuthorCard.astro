---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import {
  AUTHOR_PHOTO_SIZES,
  authorPhotoWidths,
  OPTIMIZED_IMAGE_FORMAT,
  OPTIMIZED_IMAGE_QUALITY,
} from '../../lib/images';
import Button from '../ui/Button.astro';

interface Props {
  name: string;
  role: string;
  photo: ImageMetadata;
  linkedin: string;
  email: string;
}

const { name, role, photo, linkedin, email } = Astro.props;
---

<article class="flex flex-col gap-8">
  <div class="aspect-square overflow-hidden">
    <Image
      src={photo}
      alt={name}
      widths={authorPhotoWidths(photo.width)}
      sizes={AUTHOR_PHOTO_SIZES}
      format={OPTIMIZED_IMAGE_FORMAT}
      quality={OPTIMIZED_IMAGE_QUALITY}
      class="size-full object-cover"
    />
  </div>
  <div>
    <h3 class="text-xl leading-7 font-semibold">{name}</h3>
    <p class="text-lg leading-6.5">{role}</p>
  </div>
  <div class="flex flex-col items-start gap-2">
    <Button
      href={linkedin}
      variant="outline"
      icon="linkedin"
      external
      aria-label={`${name} on LinkedIn`}>LinkedIn</Button
    >
    <Button
      href={`mailto:${email}`}
      variant="outline"
      icon="mail"
      aria-label={`Email ${name}`}>Email</Button
    >
  </div>
</article>
