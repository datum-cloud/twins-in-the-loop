---
import type { ImageMetadata } from 'astro';
import type { AuthorId } from '../../lib/types';
import Button from '../ui/Button.astro';

interface Props {
  author: AuthorId;
  name: string;
  role: string;
  photo: ImageMetadata;
  linkedin: string;
  email: string;
}

const { author, name, role, photo, linkedin, email } = Astro.props;
const accent = author === 'zac' ? 'border-zac' : 'border-jacob bg-jacob-tag';
---

<article class="flex flex-col gap-8">
  <div class:list={['aspect-square overflow-hidden border-b-8', accent]}>
    <img src={photo.src} alt={name} class="size-full object-cover" />
  </div>
  <div>
    <h3 class="text-xl font-semibold leading-7">{name}</h3>
    <p class="text-lg leading-6.5">{role}</p>
  </div>
  <div class="flex flex-col items-start gap-2">
    <Button href={linkedin} variant="outline" icon="linkedin" external>LinkedIn</Button>
    <Button href={`mailto:${email}`} variant="outline" icon="mail">Email</Button>
  </div>
</article>
