# Copy to `.env` for local builds. Astro loads `.env` at `bun run dev` / `bun run build`.
# Do not commit `.env`.

# Indexing is allowed only when PUBLIC_SITE_ENV=production.
# Any other value (or unset) is site-wide noindex and skips the sitemap.

# --- Production (twinsintheloop.com) ---
# PUBLIC_SITE_ENV=production
# SITE=https://twinsintheloop.com
# BASE_PATH=/

# --- Staging (Vercel Preview) ---
# PUBLIC_SITE_ENV=staging
# SITE=https://twinsintheloop.com
# BASE_PATH=/

PUBLIC_SITE_ENV=staging
SITE=https://twinsintheloop.com
BASE_PATH=/

# --- Strapi ---
# Blog posts come from the `twins-post` collection. The token needs read access
# to both `twins-post` and `topic`; neither is public in the CMS bootstrap.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=

# Shared secret for the cache-invalidation webhook. Must match the
# `Authorization: Bearer <secret>` header on the Strapi Admin webhook.
# When unset, /api/strapi-webhook returns 503 rather than accepting anything.
STRAPI_WEBHOOK_SECRET=

# Only needed when uploads are served from a different host than STRAPI_URL,
# which is the case on Strapi Cloud. Falls back to STRAPI_URL when empty.
STRAPI_ASSETS_URL=