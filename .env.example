# Copy to `.env` for local builds. Astro loads `.env` at `bun run dev` / `bun run build`.
# Do not commit `.env`.

# Indexing is allowed only when PUBLIC_SITE_ENV=production.
# Any other value (or unset) is site-wide noindex and skips the sitemap.

# --- Production (twinsintheloop.com) ---
# PUBLIC_SITE_ENV=production
# SITE=https://twinsintheloop.com
# BASE_PATH=/

# --- Staging (GitHub Pages project site) ---
# PUBLIC_SITE_ENV=staging
# SITE=https://<owner>.github.io
# BASE_PATH=/<repo>

PUBLIC_SITE_ENV=staging
SITE=https://twinsintheloop.com
BASE_PATH=/
